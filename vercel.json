{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/((?!api|assets|public|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}

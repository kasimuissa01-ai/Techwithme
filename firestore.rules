rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for WaitlistSubscriber
    function isValidWaitlistSubscriber(data) {
      return data.keys().hasAll(['email', 'createdAt'])
        && data.keys().size() >= 2
        && data.keys().size() <= 4
        && data.email is string
        && data.email.size() > 5
        && data.email.size() <= 200
        && data.createdAt == request.time
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && (!('source' in data) || (data.source is string && data.source.size() <= 100));
    }

    // Matches the waitlist subscribers collection
    match /waitlist/{subscriberId} {
      allow create: if isValidId(subscriberId) && isValidWaitlistSubscriber(incoming());
      allow read, update, delete: if false; // Strict privacy: clients can never query sub data
    }

    // Matches aggregated count of waitlist subscribers
    match /stats/{statId} {
      allow get: if isValidId(statId);
      allow create: if statId == 'waitlist'
        && incoming().keys().hasAll(['count'])
        && incoming().keys().size() == 1
        && incoming().count is int
        && incoming().count == 1;
      allow update: if statId == 'waitlist'
        && incoming().keys().hasAll(['count'])
        && incoming().keys().size() == 1
        && incoming().count is int
        && incoming().count == existing().count + 1;
      allow list, delete: if false;
    }
  }
}
